{
  "agent": {
    "metrics_collection_interval": 30,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/texly/compile-runner.log",
            "log_group_name": "/texly/compile-runner",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "Texly/CompileFleet",
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent", "inodes_free", "free"],
        "metrics_collection_interval": 30,
        "resources": ["/var/compile"]
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 30
      },
      "cpu": {
        "measurement": ["cpu_usage_idle", "cpu_usage_iowait", "cpu_usage_system", "cpu_usage_user"],
        "metrics_collection_interval": 30,
        "totalcpu": true
      }
    },
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "InstanceId": "${aws:InstanceId}"
    }
  }
}
