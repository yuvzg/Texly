# ==============================================================================
# Texly Environment Variables Configuration
# ==============================================================================

# Node Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Service URLs / Origins
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# PostgreSQL 17 Database
DATABASE_URL="postgresql://texly:texly_dev_secret@localhost:5432/texly?schema=public"
SHADOW_DATABASE_URL="postgresql://texly:texly_dev_secret@localhost:5432/texly_shadow?schema=public"
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Redis 7 Cache & Queue
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Storage: Local MinIO S3 Emulator (Default for Local Development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_secret
S3_BUCKET_NAME=texly-storage
S3_FORCE_PATH_STYLE=true

# Storage: Cloudflare R2 (Production / Remote)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=texly-production
R2_PUBLIC_URL=https://assets.texly.app

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=development_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=development_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=development_cookie_secret_change_in_production_32_chars

# Email Service (Mailpit local SMTP for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=noreply@texly.app

# AI / LLM Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""

