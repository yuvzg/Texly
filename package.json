{
  "name": "texly-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "turbo build",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "clean": "turbo clean && rm -rf dist .turbo apps/*/.next apps/*/dist packages/*/dist",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky || true",
    "test": "turbo test && vitest run tests/",
    "typecheck": "turbo typecheck && tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.20.0",
    "@texly/config": "workspace:*",
    "@types/node": "^22.13.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "turbo": "^2.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
