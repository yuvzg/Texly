{
  "name": "@texly/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "dev": "node --watch src/entrypoints/api.ts",
    "start": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@texly/db": "workspace:*",
    "@texly/latex": "workspace:*",
    "@texly/llm": "workspace:*",
    "@texly/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "pino": "^9.6.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@texly/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}

